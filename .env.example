# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# Sync to NKERP (Najaf accommodation allocation engine, server-side)
# Set these as server secrets. They never reach the browser.
# ------------------------------------------------------------------
# NKERP account with the "Tour and Accomodation Admin" role (74).
NKERP_LOGIN_ID=""
NKERP_PASSWORD=""
# Google service-account key: the key file's JSON text (or base64 of it).
# Share the Sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=""
# ...or a path to the key file instead of the JSON text.
# GOOGLE_SERVICE_ACCOUNT_FILE="/secrets/google-service-account.json"
# Optional access key staff enter once per device to run the sync.
# Without it there is no key: anyone who can open the app can run the sync.
NKERP_SYNC_ACCESS_KEY=""
# Optional: a different spreadsheet (defaults to the Faiz Husaini Zaereen Accommodation sheet).
# NAJAF_SHEET_ID=""
# Optional: parallel NKERP tour reads (1-8, default 4).
# NKERP_SYNC_CONCURRENCY="4"
# Optional: Gemini model for plain-language instructions in the Sync tab
# (uses GEMINI_API_KEY above; without a key, built-in rules are used).
# GEMINI_MODEL="gemini-flash-latest"
